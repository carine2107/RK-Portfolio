# ---------------------------------------------------------------------------
# Romial Kenmogne — website environment variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Application ------------------------------------------------------------
# Public base URL, used for canonical URLs, hreflang, sitemap, Open Graph and
# the links inside transactional e-mails. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:4313
NODE_ENV=development

# --- Database (PostgreSQL) --------------------------------------------------
# `docker compose up -d` starts a matching database on port 5437.
DATABASE_URI=postgres://romial:romial@localhost:5437/romial_website

# --- Payload CMS ------------------------------------------------------------
# Long random string used to sign CMS sessions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The application refuses to start in production with an empty/default secret.
PAYLOAD_SECRET=change-me-in-every-environment

# Set to `false` to run the public site from the built-in starter content only
# (no database needed). Useful for a static preview or a first deploy.
CMS_ENABLED=true

# --- E-mail (contact form notifications + confirmations) --------------------
# Leave EMAIL_ENABLED=false until a real SMTP account is configured: the contact
# form then still validates and stores the message, but tells the visitor that
# e-mail delivery is not active yet instead of pretending it was sent.
EMAIL_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# "From" address used for outgoing mail (must be allowed by the SMTP provider).
EMAIL_FROM="Romial Kenmogne <no-reply@example.com>"
# Where contact requests are delivered.
EMAIL_TO=contact@example.com

# --- Anti-spam / rate limiting ---------------------------------------------
# Maximum contact submissions per IP per window (production: 5; a dev/test
# environment can raise it so the end-to-end suite is not throttled).
CONTACT_RATE_LIMIT=5
CONTACT_RATE_WINDOW_MINUTES=15

# --- Data retention (GDPR) ---------------------------------------------------
# Contact requests are deleted automatically once unchanged for this many
# months (checked daily by the server). 0 disables the deletion.
CONTACT_RETENTION_MONTHS=24

# --- Analytics (privacy-friendly, optional) --------------------------------
# Self-hosted Umami or Plausible. Leave empty to disable analytics entirely —
# no script is loaded and no cookie banner is required.
NEXT_PUBLIC_ANALYTICS_PROVIDER=
NEXT_PUBLIC_ANALYTICS_SCRIPT_URL=
NEXT_PUBLIC_ANALYTICS_SITE_ID=

# --- Media storage ----------------------------------------------------------
# `local` stores uploads in ./public/media. Switch to an object storage adapter
# for production if the host has an ephemeral filesystem (see docs/DEPLOYMENT.md).
MEDIA_STORAGE=local

# --- Seed script ------------------------------------------------------------
# Credentials created by `npm run seed` for the first administrator.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-now

# --- Direct book sales (optional) ---------------------------------------------
# The shop opens only when these keys are set AND "Open direct sales" is ticked
# in the CMS (Shop → Settings). Use TEST keys here (Stripe test mode, PayPal sandbox).
# Stripe: Dashboard → Developers → API keys; webhook endpoint
#   <site>/api/shop/stripe/webhook with checkout.session.completed,
#   checkout.session.async_payment_succeeded and checkout.session.expired.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# PayPal: developer.paypal.com → Apps & Credentials.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
