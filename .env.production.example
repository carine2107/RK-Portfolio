# ---------------------------------------------------------------------------
# Production environment — copy to `.env.production`, fill in, `chmod 600`.
# NEVER commit `.env.production`. Used by docker-compose.prod.yml both for the
# containers and for the build arguments (--env-file .env.production).
# ---------------------------------------------------------------------------

# Public URL, no trailing slash. Written into the build: rebuild after a change.
NEXT_PUBLIC_SITE_URL=https://romialkenmogne.com

# Host port of the application (the reverse proxy forwards to it).
APP_PORT=4313

# --- Database -----------------------------------------------------------------
# The application's DATABASE_URI is assembled from these three values.
POSTGRES_USER=romial
# Letters and digits only: it is inserted into a connection URL.
POSTGRES_PASSWORD=<long random password>
POSTGRES_DB=romial_website

# --- Payload CMS ----------------------------------------------------------------
# 48 random bytes, different for staging and production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
PAYLOAD_SECRET=<48 random bytes in hex>
CMS_ENABLED=true

# --- E-mail (contact form) ------------------------------------------------------
# Keep false until the SMTP account has been tested end to end.
EMAIL_ENABLED=false
SMTP_HOST=smtp.provider.tld
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Romial Kenmogne <no-reply@romialkenmogne.com>"
EMAIL_TO=contact@romialkenmogne.com

# --- Anti-spam ------------------------------------------------------------------
CONTACT_RATE_LIMIT=5
CONTACT_RATE_WINDOW_MINUTES=15

# --- Data retention (GDPR) ----------------------------------------------------
# Contact requests unchanged for this many months are deleted (daily). 0 = never.
CONTACT_RETENTION_MONTHS=24

# Self-hosted Umami or Plausible (cookieless, no banner), or Google Analytics 4.
# Leave empty to disable analytics entirely — no script, no banner.
# Google Analytics: PROVIDER=google, SITE_ID=G-XXXXXXXXXX (Admin → Data streams),
# SCRIPT_URL empty. It sets cookies, so a consent banner is shown and nothing is
# loaded from Google before the visitor accepts. Update the cookie and privacy
# policies before enabling it. Build-time values: rebuild after a change.
NEXT_PUBLIC_ANALYTICS_PROVIDER=
NEXT_PUBLIC_ANALYTICS_SCRIPT_URL=
NEXT_PUBLIC_ANALYTICS_SITE_ID=

MEDIA_STORAGE=local

# --- First administrator (used once by `npm run seed`, then remove) -------------
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Direct book sales (optional) ---------------------------------------------
# The shop opens only when these keys are set AND "Open direct sales" is ticked
# in the CMS (Shop → Settings). Use LIVE keys in production.
# Stripe: Dashboard → Developers → API keys; webhook endpoint
#   <site>/api/shop/stripe/webhook with checkout.session.completed,
#   checkout.session.async_payment_succeeded and checkout.session.expired.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# PayPal: developer.paypal.com → Apps & Credentials.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=live

# --- Google Sheets (optional) -------------------------------------------------
# Copies new contact requests and confirmed newsletter subscribers to a Google
# spreadsheet (works with a free Google account). Leave empty to disable.
# Setup: docs/DEPLOIEMENT.md, "Google Sheets". Share the spreadsheet as "Editor"
# with the service account e-mail. Paste the "private_key" of the JSON key
# between double quotes, on one line, keeping the \n sequences.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
